[Unit]
Description=AirPlay hub control web UI
Documentation=https://github.com/HarrisonWu/airplay-hub
# The application drives MPD, Bluetooth and an optical drive, and reads an
# AirPlay metadata pipe; it manages none of them, so they come first.
After=network.target mpd.service bluetooth.service
Wants=mpd.service

[Service]
Type=simple
# The package lives at /opt/cdplayer/airplay_hub and is imported as a package,
# so the working directory has to be the application root.
WorkingDirectory=/opt/cdplayer
ExecStart=/usr/bin/python3 -m airplay_hub

# The audio server is per user. PipeWire and PulseAudio both publish a socket at
# /run/user/<uid>/pulse/native, mode 0700, so only that one account can reach it.
# MPD, shairport-sync and this service all play into the same graph, so all three
# must run as the account that owns the audio server -- normally the human
# account, not a system account.
#
# User= and XDG_RUNTIME_DIR below are one setting in two halves and must be
# edited together: XDG_RUNTIME_DIR has to be /run/user/<uid of User=>. The units
# below are one working pair for a stock Raspberry Pi OS image, where the account
# created during imaging is uid 1000.
User=1000
Group=audio
SupplementaryGroups=audio
# Written numerically because systemd does not expand %U to the User= value in a
# system unit -- it resolves specifiers against the service manager's own user,
# so /run/user/%U arrives as /run/user/0. libpulse then cannot connect, and every
# output switch fails with the misleading "no wired output is available".
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1

# Seconds subtracted from the reported AirPlay position. Raise it for a
# Bluetooth output path, which adds more latency than a wired DAC.
Environment=AIRPLAY_HUB_AP_LATENCY=0.05
# Parent directory of the meta/ disc metadata cache.
Environment=AIRPLAY_HUB_DATA_DIR=/opt/cdplayer
# Only needed when the install renames its wired sink; the default is to use the
# first non-Bluetooth sink.
#Environment=AIRPLAY_HUB_WIRED_SINK=output_wired

Restart=on-failure
RestartSec=3

# The process writes the metadata cache, and a rip writes into the music
# library. Both stay inside the two paths below; everything else is read-only.
# PrivateTmp is deliberately NOT enabled: shairport-sync creates its metadata
# pipe at /tmp/shairport-sync-metadata, and a private /tmp would hide it.
# ProtectHome is read-only rather than yes: "yes" replaces /home, /root and
# /run/user with empty inaccessible directories, which hides the audio socket
# this unit exists to talk to. ReadWritePaths= does not undo that. "read-only"
# keeps /home closed to writes without taking /run/user away.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/cdplayer /var/lib/mpd/music

[Install]
WantedBy=multi-user.target
